# ══════════════════════════════════════════════════════════════════════════════
# Black House — repository ignore rules
# ══════════════════════════════════════════════════════════════════════════════

# ── Secrets & local environment ───────────────────────────────────────────────
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
secrets.*

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/node_modules/.tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# TypeScript incremental build info + accidental emit from `tsc -b`.
# vite.config.js / vite.config.d.ts are *outputs* — the source is vite.config.ts.
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# ── Python / backend ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
backend/.venv/
backend/venv/
backend/env/
*.egg-info/
.eggs/
backend/build/
backend/dist/
.installed.cfg

# Test / lint caches and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local databases and uploaded media (never commit these)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/storage/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
