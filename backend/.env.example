# ═════════════════════════════════════════════════════════════════════════════
# Black House — commerce backend environment
#
#   cp .env.example .env      # then edit the values marked ⚠
#
# .env is git-ignored. Environment variables always override this file, so the
# same image can be promoted across environments by changing the env only.
#
# ⚠ = must be changed before deploying anywhere real.
# ═════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
# development | staging | production | test
# `production`/`staging` boot with fail-fast validation (see app/core/config.py):
# they refuse a default SECRET_KEY, SQLite, APP_DEBUG=true, wildcard CORS or the
# local storage driver.
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# ── Metrics (/metrics, Prometheus) ──────────────────────────────────────────
# Requires pip install ".[observability]". Set METRICS_TOKEN unless the
# endpoint is network-isolated: counters leak traffic shape and route names.
METRICS_ENABLED=true
METRICS_TOKEN=
# REQUIRED when running more than one worker (gunicorn). Without it each worker
# keeps its own counters and a scrape is answered by a random worker, so every
# metric undercounts by the worker count. gunicorn_conf.py and the Dockerfile
# already set a sane default; override only if /tmp is not writable.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ⚠ Signs JWTs and refresh-token digests. Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Rotating it invalidates every issued token (all users must sign in again).
SECRET_KEY=change-me-to-a-long-random-string

# Public origins, used to build absolute links (webhooks, email, wa.me).
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (psycopg 3) everywhere it is deployed; SQLite is a dev/test mirror.
#   docker:  postgresql+psycopg://blackhouse:blackhouse@db:5432/blackhouse
#   local:   postgresql+psycopg://blackhouse:blackhouse@localhost:5432/blackhouse
#   managed: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
#   sqlite:  sqlite:///./blackhouse.db
DATABASE_URL=postgresql+psycopg://blackhouse:blackhouse@localhost:5432/blackhouse

# Connection pool (ignored on SQLite). Size ≈ expected concurrent requests;
# remember every API replica opens its own pool.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# true logs every SQL statement — noisy, use only while debugging queries.
DATABASE_ECHO=false

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Used only for the shared rate limiter. Empty = in-process limiter, which is
# fine for a single instance but not across replicas.
REDIS_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array or comma-separated list. Credentials are sent, so wildcards are
# rejected outside development. Add every origin that serves the storefront.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Leave the keys EMPTY to run the built-in mock gateway (dev/test only). With
# keys set, /payments/mock-capture is disabled and webhooks are signature-verified.
# Dashboard → Settings → API Keys (test mode first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ⚠ Dashboard → Webhooks → point at {API_BASE_URL}/api/v1/webhooks/razorpay and
#   copy the secret here. Subscribe to: payment.captured, payment.failed,
#   order.paid, refund.processed, refund.failed.
RAZORPAY_WEBHOOK_SECRET=

# ── Notification providers ───────────────────────────────────────────────────
# `log` records the notification row and prints it — safe default, no vendor.
# Real providers plug into services/notification_service.py.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=orders@blackhouse.example

SMS_PROVIDER=
SMS_API_KEY=

# Automated WhatsApp needs WhatsApp Business Platform access; until then staff
# use generated wa.me links (/orders/{id}/whatsapp-link).
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
# Digits only, international format, no + or spaces.
WHATSAPP_BUSINESS_NUMBER=910000000000

# ── Object storage ───────────────────────────────────────────────────────────
# local | s3 | cloudinary
# `local` writes to STORAGE_LOCAL_PATH and serves it at /static/uploads — good
# for dev, NOT durable across container restarts. Use s3/cloudinary in prod.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=/static/uploads

# ── Commerce defaults (seed values for run-time BusinessSettings) ────────────
# An admin can change these later via /api/v1/admin/settings without a redeploy.
WAREHOUSE_CITY=Bhopal
WAREHOUSE_STATE=Madhya Pradesh
WAREHOUSE_COUNTRY=IN
DEFAULT_CURRENCY=INR

RESERVATION_TTL_MINUTES=30
PAYMENT_RETRY_COOLDOWN_SECONDS=120
RETURN_WINDOW_DAYS=7
LOW_STOCK_THRESHOLD=3
# Empty = no free-shipping threshold. Money is integer paise (₹15,000 = 1500000).
FREE_SHIPPING_THRESHOLD_PAISE=1500000
DEFAULT_SHIPPING_CHARGE_PAISE=9900
# allowlist = only listed PIN codes are serviceable; denylist = everything except
# the blocked ones. Seeded data assumes denylist.
PINCODE_MODE=denylist
STAFF_CAN_CANCEL_BEFORE_PACKING=true
ORDER_NUMBER_PREFIX=BH
RATE_LIMIT_PER_MINUTE=30
# Blanket limit the middleware applies to every other /api/ route. Protects new
# endpoints by default instead of only those that opt into the decorator above.
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Master kill switch. Set false to disable all limiting (e.g. during a load test).
RATE_LIMIT_ENABLED=true
# Behind a PaaS load balancer the TCP peer is the proxy, not the shopper. Leave
# true on Render/Railway/Fly so the real client IP is read from X-Forwarded-For
# (rate limiting and audit logging both depend on it). Set false ONLY if the
# container is exposed directly to the internet - otherwise the header becomes a
# rate-limit bypass. See backend/app/core/net.py.
TRUST_PROXY_HEADERS=true
