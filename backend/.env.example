# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://blackhouse:blackhouse@localhost:5432/blackhouse
# Optional. Only used for rate limiting / shared ephemeral state when set.
REDIS_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
# Leave keys empty to run the built-in mock gateway (dev/test only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Notification providers ──────────────────────────────────────────────────
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=orders@blackhouse.example
SMS_PROVIDER=
SMS_API_KEY=
# Automated WhatsApp requires WhatsApp Business Platform/API access.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
# Direct-to-customer WhatsApp number used only for *manual* wa.me links (staff tooling).
WHATSAPP_BUSINESS_NUMBER=910000000000

# ── Object storage ──────────────────────────────────────────────────────────
# local | s3 | cloudinary
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_LOCAL_PATH=./storage/uploads

# ── Commerce defaults ───────────────────────────────────────────────────────
WAREHOUSE_CITY=Bhopal
WAREHOUSE_STATE=Madhya Pradesh
WAREHOUSE_COUNTRY=IN
DEFAULT_CURRENCY=INR

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
