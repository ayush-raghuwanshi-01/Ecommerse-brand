# ─────────────────────────────────────────────────────────────────────────────
# Black House storefront — frontend environment
#
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle, so never
# put a secret here. Anything the browser needs is either public (brand copy,
# Razorpay *publishable* key) or fetched from the backend at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# ── API wiring ──────────────────────────────────────────────────────────────
# Base path the browser uses for API calls.
#   • Leave as /api/v1 when the Vite dev-server proxy (below) or the production
#     reverse proxy forwards /api to the backend — this keeps the app same-origin
#     and CORS-free, which is what you want in almost every deployment.
#   • Set an absolute URL only if the API truly lives on another origin, e.g.
#     VITE_API_BASE_URL=https://api.blackhouse.example/api/v1
VITE_API_BASE_URL=/api/v1

# Where the *dev server* forwards /api and /static. Used by vite.config.ts only
# (server-side, never shipped to the browser).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Extra hosts the Vite dev server will accept (comma separated). Needed when you
# reach the dev server through a tunnel/preview domain. The local machine and
# localhost are always allowed, so this can stay empty for normal development.
VITE_DEV_ALLOWED_HOSTS=

# ── Brand / contact ─────────────────────────────────────────────────────────
VITE_BRAND_NAME=Black House
VITE_BRAND_TAGLINE=Small-batch outerwear
VITE_CONTACT_EMAIL=hello@blackhouse.example
# International format, digits only. Used for manual wa.me deep links.
VITE_WHATSAPP_NUMBER=910000000000
VITE_SUPPORT_PHONE=

# ── Analytics / third parties (optional) ────────────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=

# ── Build ───────────────────────────────────────────────────────────────────
# Overridden automatically by Vite; set only if you need to pin it.
VITE_APP_ENV=development
