# ═════════════════════════════════════════════════════════════════════════════
# Black House — root environment for `docker compose`
#
#   cp .env.example .env
#
# This file serves two purposes:
#   1. Compose variable interpolation (${POSTGRES_USER}, ${API_PORT}, …).
#   2. Injected verbatim into the `api` container via `env_file`, so it carries
#      the application settings too (SECRET_KEY, Razorpay, storage, …).
#
# Running the backend WITHOUT Docker? Use `backend/.env.example` instead —
# that copy is read by pydantic-settings from the backend working directory.
#
# Never commit the real .env. Rotate any secret that has ever been pushed.
# ═════════════════════════════════════════════════════════════════════════════

# ── Ports published on your machine ──────────────────────────────────────────
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# ⚠ Change before anything reachable from a network.
POSTGRES_USER=blackhouse
POSTGRES_PASSWORD=blackhouse
POSTGRES_DB=blackhouse

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ⚠ Signs JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# The `web` container proxies /api itself, so CORS only matters when the Vite dev
# server (port 5173) talks to a published API port.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

# ── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Payments (Razorpay) — empty keys = built-in mock gateway ─────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=log
EMAIL_FROM=orders@blackhouse.example
SMS_PROVIDER=
WHATSAPP_PROVIDER=
WHATSAPP_BUSINESS_NUMBER=910000000000

# ── Storage (local volume in compose; use s3/cloudinary in production) ───────
STORAGE_PROVIDER=local

# ── Storefront build args ────────────────────────────────────────────────────
VITE_BRAND_NAME=Black House
VITE_CONTACT_EMAIL=hello@blackhouse.example
